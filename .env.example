# Development defaults: device requests fail clearly; print results are previews.
KIOSK_HOST=127.0.0.1
KIOSK_PORT=8002
KIOSK_NFC=disabled
KIOSK_NFC_TIMEOUT=10
KIOSK_PRINT=screen

# For an actual Pi: install requirements-hardware.txt and select pcsc + escpos.
# Read vendor/product IDs from the actual printer; do not copy another model's IDs.
# KIOSK_ESCPOS_VENDOR=
# KIOSK_ESCPOS_PRODUCT=
# KIOSK_CUPS_PRINTER=

# Explicit backend integration testing only. Never use mock as a real-card claim.
# KIOSK_NFC=mock
# KIOSK_NFC_MOCK_UID=04A1B2C3D4E5F6

# Temporary generated images stay in one server process and expire automatically.
KIOSK_PROFILE_TTL_SECONDS=600
KIOSK_PROFILE_MAX_ITEMS=8
KIOSK_PREVIEW_TTL_SECONDS=300

# Names/UIDs/upstream report credentials expire after this many hours.
# Operation tombstones remain to prevent replay of uncertain physical outputs.
KIOSK_SESSION_RETENTION_HOURS=24
# KIOSK_DB_PATH=/absolute/private/path/kiosk.sqlite3

# Enable only after the trusted MirrorTing server-side bridge is configured.
# Base URL is configured by the operator; visitors cannot provide a URL.
KIOSK_MIRRORTING_URL=
KIOSK_BRIDGE_TOKEN=
